{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "1.0.0",
  "id": "REPLACE_WITH_TEAMS_APP_UUID",
  "packageName": "com.example.observabilityagent",
  "developer": {
    "name": "Your organization",
    "websiteUrl": "https://YOUR_PUBLIC_HOST",
    "privacyUrl": "https://YOUR_PUBLIC_HOST/privacy",
    "termsOfUseUrl": "https://YOUR_PUBLIC_HOST/terms"
  },
  "name": {"short": "Observability Agent", "full": "Observability Investigation Agent"},
  "description": {
    "short": "Investigate telemetry incidents",
    "full": "Investigate incidents using traces, metrics, and logs from your configured telemetry backends."
  },
  "icons": {"outline": "outline.png", "color": "color.png"},
  "accentColor": "#16324F",
  "bots": [{
    "botId": "REPLACE_WITH_TEAMS_APP_ID",
    "scopes": ["personal", "team", "groupChat"],
    "isNotificationOnly": false,
    "supportsFiles": false
  }],
  "validDomains": ["YOUR_PUBLIC_HOST"]
}
