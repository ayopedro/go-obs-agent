# Required: azure, copilot, or anthropic. The model must support function calling.
LLM_PROVIDER=azure

# azure: LLM_BASE_URL is the resource endpoint, LLM_MODEL the deployment name.
# Leave LLM_API_KEY empty to use Microsoft Entra ID (managed identity, az login).
LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com
LLM_MODEL=
LLM_API_KEY=
# Optional; empty uses the default in code (2024-10-21).
LLM_AZURE_API_VERSION=

# copilot: LLM_MODEL optional; do not set LLM_BASE_URL, LLM_API_KEY or
# LLM_AZURE_API_VERSION. Servers need a token (locally use `copilot login`).
COPILOT_CLI_PATH=
COPILOT_GITHUB_TOKEN=

# anthropic: LLM_MODEL and LLM_API_KEY required; LLM_BASE_URL optional gateway.

# Optional JSON file listing remote MCP servers and allowed tools (see README).
MCP_CONFIG=

TEMPO_BASE_URL=http://localhost:3200
PROMETHEUS_BASE_URL=http://localhost:9090
LOKI_BASE_URL=http://localhost:3100

# Optional chat server (go run ./cmd/server). Configure one or both platforms.
HTTP_ADDR=127.0.0.1:8080
# Include raw prompt text in audit logs (default: only a hash and length).
AUDIT_LOG_PROMPTS=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
# Teams: single-tenant Azure Bot, public Microsoft cloud.
TEAMS_APP_ID=
TEAMS_APP_SECRET=
TEAMS_TENANT_ID=
