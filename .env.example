# Default: use authenticated Copilot CLI. Empty model uses the runtime default.
LLM_PROVIDER=copilot
LLM_MODEL=
# Optional path to the installed Copilot CLI executable.
COPILOT_CLI_PATH=

# Custom inference provider: openai (compatible endpoints), azure, or anthropic.
# Requires LLM_MODEL and LLM_BASE_URL. Do not set these for Copilot mode.
LLM_BASE_URL=
LLM_API_KEY=
# Optional for openai/azure: completions or responses.
LLM_WIRE_API=
# Optional for azure; empty uses the SDK's default route.
LLM_AZURE_API_VERSION=

TEMPO_BASE_URL=http://localhost:3200
PROMETHEUS_BASE_URL=http://localhost:9090
LOKI_BASE_URL=http://localhost:3100
